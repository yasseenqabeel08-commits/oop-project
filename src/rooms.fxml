<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="RoomsController">

    <!-- TOP -->
    <top>
        <Label fx:id="welcomeLabel"
               text="Welcome"
               style="-fx-font-size: 18px; -fx-padding: 10;" />
    </top>

    <!-- CENTER -->
    <center>
        <TableView fx:id="roomTable">
            <columns>
                <TableColumn fx:id="colRoomNumber" text="Room #" prefWidth="150"/>
                <TableColumn fx:id="colPrice" text="Price" prefWidth="150"/>
            </columns>
        </TableView>
    </center>

    <!-- BOTTOM -->
    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button text="Reserve" onAction="#handleReserve"/>
            <Button text="Back" onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>