<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="RoomsController">

    <!-- TOP -->
    <top>
        <Label fx:id="welcomeLabel"
               text="Welcome"
               style="-fx-font-size: 18px; -fx-padding: 10;" />
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="10" style="-fx-padding: 10;">

            <!-- FILTER -->
            <HBox spacing="10">
                <TextField fx:id="priceField" promptText="Max Price"/>
                <TextField fx:id="typeField" promptText="Room Type"/>
                <Button text="Filter" onAction="#handleFilter"/>
                <Button text="Reset" onAction="#handleReset"/>
            </HBox>

            <!-- TABLE -->
            <TableView fx:id="roomTable">
                <columns>
                    <TableColumn fx:id="colRoomNumber" text="Room #" prefWidth="120"/>
                    <TableColumn fx:id="colPrice" text="Price" prefWidth="120"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                </columns>
            </TableView>

        </VBox>
    </center>

    <!-- BOTTOM -->
    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button text="Reserve" onAction="#handleReserve"/>
            <Button text="Back" onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>