<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane fx:controller="GuestDashboardController"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="900" prefHeight="700">

    <!-- 🔹 TOP -->
    <top>
        <Label fx:id="welcomeLabel"
               text="Welcome Guest!"
               style="-fx-padding: 10; -fx-font-size: 16;"/>
    </top>

    <!-- 🔹 LEFT SIDE MENU -->
    <left>
        <VBox spacing="15" style="-fx-padding: 15;">
            <Button text="Profile" onAction="#handleProfile"/>
            <Button text="Browse Rooms" onAction="#handleBrowseRooms"/>
            <Button text="My Reservations" onAction="#handleMyReservations"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- 🔹 CENTER CONTENT -->
    <center>
        <StackPane>

            <!-- PROFILE -->
            <VBox fx:id="profilePane" spacing="10" visible="false">
                <Label text="Profile Information"/>
                <Label fx:id="nameLabel" text="Name:"/>
                <Label fx:id="balanceInfoLabel" text="Balance:"/>
                <Label fx:id="addressLabel" text="Address:"/>
            </VBox>

            <!-- ROOMS -->
            <VBox fx:id="roomsPane" spacing="10" visible="false">
                <Label text="Browse Rooms"/>
            </VBox>

            <!-- RESERVATIONS -->
            <VBox fx:id="reservationPane" spacing="10" visible="false">

                <TableView fx:id="bookingTable" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="colRoom" text="Room"/>
                        <TableColumn fx:id="colCheckIn" text="Check In"/>
                        <TableColumn fx:id="colCheckOut" text="Check Out"/>
                        <TableColumn fx:id="colReservationStatus" text="Status"/>
                        <TableColumn fx:id="colStatus" text="Payment Status"/>
                    </columns>
                </TableView>

                <HBox spacing="10">
                    <Button text="View History" onAction="#handleViewHistory"/>
                    <Button text="View Active" onAction="#handleViewActive"/>
                    <Button text="Cancel Reservation" onAction="#handleCancelReservation"/>
                </HBox>

            </VBox>

        </StackPane>
    </center>

    <!-- 🔹 BOTTOM CHAT (FIXED 🔥) -->
    <bottom>
        <VBox spacing="5" style="-fx-padding: 10;">

            <TextArea fx:id="chatArea"
                      editable="false"
                      wrapText="true"
                      prefHeight="150"/>

            <HBox spacing="10">
                <TextField fx:id="messageField" HBox.hgrow="ALWAYS"/>
                <Button text="Send" onAction="#sendMessage"/>
            </HBox>

        </VBox>
    </bottom>

</BorderPane>