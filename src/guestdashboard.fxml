<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.*?>

<AnchorPane fx:controller="GuestDashboardController"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="800" prefHeight="600">

    <!-- 🔹 TOP LABEL -->
    <Label fx:id="welcomeLabel" layoutX="200" layoutY="10" text="Welcome Guest!" />

    <!-- 🔹 PROFILE PANE -->
    <VBox fx:id="profilePane" layoutX="200" layoutY="50" spacing="10" visible="false">
        <Label text="Profile Information"/>
        <Label fx:id="nameLabel" text="Name:"/>
        <Label fx:id="balanceInfoLabel" text="Balance:"/>
        <Label fx:id="addressLabel" text="Address:"/>
    </VBox>

    <!-- 🔹 ROOMS PANE -->
    <VBox fx:id="roomsPane" layoutX="200" layoutY="50" spacing="10" visible="false">
        <Label text="Browse Rooms"/>
    </VBox>

    <!-- 🔹 RESERVATION PANE -->
    <VBox fx:id="reservationPane" layoutX="200" layoutY="50" spacing="10" visible="false">

        <TableView fx:id="bookingTable" prefWidth="600" prefHeight="200">
            <columns>
                <TableColumn fx:id="colRoom" text="Room"/>
                <TableColumn fx:id="colCheckIn" text="Check In"/>
                <TableColumn fx:id="colCheckOut" text="Check Out"/>
                <TableColumn fx:id="colReservationStatus" text="Status"/>
                <TableColumn fx:id="colStatus" text="Payment Status"/>
            </columns>
        </TableView>

        <Button text="View History" onAction="#handleViewHistory"/>
        <Button text="View Active" onAction="#handleViewActive"/>
        <Button text="Cancel Reservation" onAction="#handleCancelReservation"/>
    </VBox>

    <!-- 🔹 SIDE BUTTONS -->
    <VBox layoutX="20" layoutY="50" spacing="15">
        <Button text="Profile" onAction="#handleProfile"/>
        <Button text="Browse Rooms" onAction="#handleBrowseRooms"/>
        <Button text="My Reservations" onAction="#handleMyReservations"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </VBox>

    <!-- 🔹 CHAT BOX -->
    <!-- 🔹 CHAT BOX -->
    <VBox layoutX="200" layoutY="320" prefWidth="580" spacing="5">

        <TextArea fx:id="chatArea"
                  editable="false"
                  wrapText="true"
                  prefHeight="150"
                  minHeight="150"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="messageField" prefWidth="480" HBox.hgrow="ALWAYS"/>
            <Button text="Send" onAction="#sendMessage"/>
        </HBox>

    </VBox>

</AnchorPane>